App() { title: "t" width: 520 height: 300 background: #2b2d30 renderer: vulkan aa: "ssaa2x" entry: Main }
view Main() { Stack(orientation: vertical, gap: 8, padding: 12, width: Window.width, height: Window.height, background: #2b2d30) { Stack(orientation: horizontal, gap: 6) { Button("Save", width:60, height:26, background: #393b40, textColor: #7faf7f, radius:4) Button("Settings", width:72, height:26, background: #393b40, textColor: #9da0a8, radius:4) } TextArea(text: "let x = 42 ; print(x)", highlight: "rs", width: 460, height: 180, fontSize: 14, lineNumbers: true, textColor: #dfe1e5, background: #1e1f22, radius: 6) } }
