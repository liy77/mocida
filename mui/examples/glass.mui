// glass.mui — UIGlass / backdrop showcase.
//
// Demonstrates the region-backdrop Glass widget with liquid glass, vibrancy,
// acrylic and the in-app / web blur simulation. Run with:
//
//   cargo run -p mui-dev -- mui/examples/glass.mui
//
// or via cforge listen (web):
//
//   cforge run --listen=3001 mui/examples/glass.mui

view GlassDemo() {
  mut material = signal("liquid")
  mut blurPreset = signal(2)   // 0=low, 1=med, 2=high, 3=ultra
  mut noisePreset = signal(1)  // 0=off, 1=subtle, 2=strong

  App(title: "Glass Demo", width: 900, height: 700,
      background: #0b1020, backdrop: "none") {
    Stack(orientation: vertical, gap: 0, align: center,
          width: Window.width, height: Window.height,
          background: #0b1020) {

      Glass(effect: material, radius: 20, tint: #ffffff, tintOpacity: 0.28,
            blur: blurPreset * 20 + 10,
            refraction: 0.45,
            noise: noisePreset * 0.15,
            padding: 28, margin: 24) {
        Stack(orientation: vertical, gap: 8) {
          Text("Glass & Vibrancy", size: 34, color: #ffffff)
          Text("Liquid glass, vibrancy and acrylic — including the web simulation.",
               size: 15, color: #94a3b8)
        }
      }

      // Backdrop art + glass cards stacked so blur has real content under it.
      Stack(orientation: vertical, gap: 0, width: 820, height: 280) {
        Stack(orientation: horizontal, gap: 16, padding: 24,
              width: 820, height: 280) {
          Rectangle(width: 180, height: 230, radius: 20, fill: #3b82f6)
          Rectangle(width: 180, height: 230, radius: 20, fill: #ef4444)
          Rectangle(width: 180, height: 230, radius: 20, fill: #10b981)
          Rectangle(width: 180, height: 230, radius: 20, fill: #f59e0b)
        }
        Stack(orientation: horizontal, gap: 20, padding: 30,
              width: 820, height: 280, marginTop: -280) {
          Glass(effect: material, radius: 24, tint: #ffffff, tintOpacity: 0.32,
                blur: blurPreset * 20 + 10,
                refraction: 0.5,
                noise: noisePreset * 0.15,
                padding: 24, width: 380, height: 220) {
            Stack(orientation: vertical, gap: 10) {
              Text("Frosted panel", size: 22, color: #ffffff)
              Text("Blurs and refracts the colored shapes behind it.",
                   size: 14, color: #94a3b8)
            }
          }
          Glass(effect: material, radius: 24, tint: #e2e8f0, tintOpacity: 0.42,
                blur: blurPreset * 20 + 10,
                refraction: 0.35,
                noise: noisePreset * 0.15,
                padding: 24, width: 380, height: 220) {
            Stack(orientation: vertical, gap: 10) {
              Text("Tinted panel", size: 22, color: #0f172a)
              Text("Same material, stronger tint wash on top.",
                   size: 14, color: #334155)
            }
          }
        }
      }

      Stack(orientation: vertical, gap: 12, padding: 24) {
        Text("Material", size: 18, color: #e2e8f0)
        Stack(orientation: horizontal, gap: 8) {
          Button("Liquid Glass", onClick: { material = "liquid" })
          Button("Vibrancy", onClick: { material = "vibrancy" })
          Button("Vibrancy HUD", onClick: { material = "vibrancy-hud" })
          Button("Acrylic / Frost", onClick: { material = "frost" })
        }
      }

      Stack(orientation: vertical, gap: 12, padding: 24) {
        Text("Blur preset: ${blurPreset} (0=low .. 3=ultra)", size: 14, color: #94a3b8)
        Stack(orientation: horizontal, gap: 8) {
          Button("-", onClick: { blurPreset = blurPreset - 1 })
          Button("+", onClick: { blurPreset = blurPreset + 1 })
        }

        Text("Noise preset: ${noisePreset} (0=off .. 2=strong)", size: 14, color: #94a3b8)
        Stack(orientation: horizontal, gap: 8) {
          Button("-", onClick: { noisePreset = noisePreset - 1 })
          Button("+", onClick: { noisePreset = noisePreset + 1 })
        }
      }
    }
  }
}
